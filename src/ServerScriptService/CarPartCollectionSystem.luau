--!strict
-- ============================================================================
-- CarPartCollectionSystem.luau
-- Location: roblox/src/ServerScriptService/CarPartCollectionSystem.luau
--
-- EPECUÉN: NO ESCAPE - Fiat Cronos Vehicle-Repair Component Collection System
--
-- PURPOSE:
-- Server-authoritative discovery and collection system for the five physical
-- Fiat Cronos repair components generated by CarPartPhysicalBuilder inside:
--   Workspace.EpecuenWorld.CarRepairParts
--
-- FIVE COLLECTIBLE VEHICLE COMPONENTS & OBJECTIVES:
--   1. Battery      -> VehiclePart_Battery_12V              ("Batería de Plomo 12V 75Ah")
--   2. Alternator   -> VehiclePart_Alternator_14V           ("Alternador de Carga 14V")
--   3. SparkPlugs   -> VehiclePart_SparkPlugs_Set           ("Juego de Bujías de Encendido")
--   4. FuelCanister -> VehiclePart_FuelCanister_20L         ("Bidón de Nafta 20L")
--   5. RadiatorHose -> VehiclePart_RadiatorHose_Reinforced  ("Manguera Reforzada de Refrigerante")
--
-- INTERACTION SPECIFICATION:
--   - Exactly one ProximityPrompt per physical component model.
--   - ActionText: "Recoger"
--   - ObjectText: Appropriate Spanish component name matching the objective.
--   - HoldDuration: 0.5 seconds
--   - MaxActivationDistance: 8 studs
--   - RequiresLineOfSight: true
--   - Keyboard (E), Gamepad (ButtonX), and Mobile (Tap) native compatibility.
--   - Duplicate prompt creation is strictly prohibited.
--
-- COLLECTION BEHAVIOR:
--   1. Server-authoritatively validates the target component model and objective.
--   2. Marks the objective as Found and Collected in CarPartObjectiveSystem.
--   3. Removes the physical component model from the world.
--   4. Prevents the same physical component from being collected twice.
--   5. Fiat Cronos is NOT modified at this stage.
--   6. No inventory GUI, audio, or visual effects are spawned here.
--
-- PER-PLAYER PROGRESSION:
--   - Player progress is tracked per player session, not globally.
--   - Persists across player character respawns within the current server session.
--   - Safe lifecycle cleanup on player departure (no memory or connection leaks).
--
-- ARCHITECTURE & CONSTRAINTS:
--   - Strict Luau typing (--!strict).
--   - Does NOT execute collection setup on module require.
--   - Explicit, idempotent Initialize() function.
--   - Completely isolated from handheld flashlight/camera batteries.
-- ============================================================================

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

-- ----------------------------------------------------------------------------
-- DEPENDENCY RESOLUTION: CarPartObjectiveSystem
-- ----------------------------------------------------------------------------
local function getCarPartObjectiveSystem(): any
    local parent = script.Parent
    if parent and parent:FindFirstChild("CarPartObjectiveSystem") then
        return require(parent:FindFirstChild("CarPartObjectiveSystem") :: ModuleScript)
    end
    local serverFolder = ServerScriptService:FindFirstChild("EpecuenServer")
    if serverFolder and serverFolder:FindFirstChild("CarPartObjectiveSystem") then
        return require(serverFolder:FindFirstChild("CarPartObjectiveSystem") :: ModuleScript)
    end
    local found = ServerScriptService:FindFirstChild("CarPartObjectiveSystem", true)
    if found and found:IsA("ModuleScript") then
        return require(found)
    end
    return require(ServerScriptService:WaitForChild("CarPartObjectiveSystem") :: ModuleScript)
end

local CarPartObjectiveSystem = getCarPartObjectiveSystem()

local CarPartCollectionSystem = {}

-- ----------------------------------------------------------------------------
-- TYPES
-- ----------------------------------------------------------------------------

export type ObjectiveId = "Battery" | "Alternator" | "SparkPlugs" | "FuelCanister" | "RadiatorHose"

export type PlayerProgressMap = { [ObjectiveId]: boolean }

export type CollectionRecord = {
    Player: Player,
    ObjectiveId: ObjectiveId,
    ModelName: string,
    Timestamp: number,
}

-- ----------------------------------------------------------------------------
-- CONSTANTS & CANONICAL MAPPINGS
-- ----------------------------------------------------------------------------

local PROMPT_ACTION_TEXT = "Recoger"
local PROMPT_HOLD_DURATION = 0.5
local PROMPT_MAX_ACTIVATION_DISTANCE = 8.0
local PROMPT_REQUIRES_LINE_OF_SIGHT = true
local PROMPT_NAME = "VehiclePartCollectionPrompt"

local NETWORKING_FOLDER_NAME = "CarPartRemotes"
local REMOTE_EVENT_NAME = "CarPartCollected"
local REMOTE_FUNCTION_NAME = "GetCarPartProgress"

local CANONICAL_OBJECTIVE_ORDER: { ObjectiveId } = {
    "Battery",
    "Alternator",
    "SparkPlugs",
    "FuelCanister",
    "RadiatorHose",
}

local OBJECTIVE_TO_MODEL_NAME: { [ObjectiveId]: string } = {
    Battery = "VehiclePart_Battery_12V",
    Alternator = "VehiclePart_Alternator_14V",
    SparkPlugs = "VehiclePart_SparkPlugs_Set",
    FuelCanister = "VehiclePart_FuelCanister_20L",
    RadiatorHose = "VehiclePart_RadiatorHose_Reinforced",
}

local MODEL_NAME_TO_OBJECTIVE: { [string]: ObjectiveId } = {
    VehiclePart_Battery_12V = "Battery",
    VehiclePart_Alternator_14V = "Alternator",
    VehiclePart_SparkPlugs_Set = "SparkPlugs",
    VehiclePart_FuelCanister_20L = "FuelCanister",
    VehiclePart_RadiatorHose_Reinforced = "RadiatorHose",
}

local SPANISH_OBJECT_NAMES: { [ObjectiveId]: string } = {
    Battery = "Batería de Plomo 12V 75Ah",
    Alternator = "Alternador de Carga 14V",
    SparkPlugs = "Juego de Bujías de Encendido",
    FuelCanister = "Bidón de Nafta 20L",
    RadiatorHose = "Manguera Reforzada de Refrigerante",
}

-- ----------------------------------------------------------------------------
-- INTERNAL STATE
-- ----------------------------------------------------------------------------

local isInitialized = false

-- Per-player progress table: playerProgress[Player][ObjectiveId] = true
local playerProgress: { [Player]: PlayerProgressMap } = {}

-- Track connections per player to guarantee zero leaks on PlayerRemoving
local playerConnections: { [Player]: { RBXScriptConnection } } = {}

-- System-level lifecycle connections
local systemConnections: { RBXScriptConnection } = {}

-- Track prompt connections to prevent duplicate listeners
local promptTriggerConnections: { [ProximityPrompt]: RBXScriptConnection } = {}

-- Registry of active prompts per objective
local promptByObjective: { [ObjectiveId]: ProximityPrompt } = {}

-- Mutex set for models currently being collected or collected to prevent race conditions
local collectedModels: { [Model]: boolean } = {}
local isCollectingModel: { [Model]: boolean } = {}

-- Server-side remote networking instances in ReplicatedStorage
local carPartRemotesFolder: Folder? = nil
local carPartCollectedRemote: RemoteEvent? = nil
local getCarPartProgressRemote: RemoteFunction? = nil

-- Optional server-side bindable event for decoupled listening
local partCollectedEvent = Instance.new("BindableEvent")
CarPartCollectionSystem.OnPartCollected = partCollectedEvent.Event

-- ----------------------------------------------------------------------------
-- SERVER-SIDE NETWORKING (CAR PART REMOTES)
-- ----------------------------------------------------------------------------

--- Ensures the ReplicatedStorage.CarPartRemotes hierarchy exists and is configured server-side.
--- Idempotent: reuses existing folder and remotes if already created.
local function setupNetworking(): (Folder, RemoteEvent, RemoteFunction)
    -- 1. Resolve or create ReplicatedStorage.CarPartRemotes folder
    local folder = carPartRemotesFolder
    if not (folder and folder.Parent == ReplicatedStorage) then
        local existingFolder = ReplicatedStorage:FindFirstChild(NETWORKING_FOLDER_NAME)
        if existingFolder and existingFolder:IsA("Folder") then
            folder = existingFolder
        else
            local newFolder = Instance.new("Folder")
            newFolder.Name = NETWORKING_FOLDER_NAME
            newFolder.Parent = ReplicatedStorage
            folder = newFolder
        end
        carPartRemotesFolder = folder
    end

    -- 2. Resolve or create CarPartCollected RemoteEvent
    local ev = carPartCollectedRemote
    if not (ev and ev.Parent == folder) then
        local existingEv = folder:FindFirstChild(REMOTE_EVENT_NAME)
        if existingEv and existingEv:IsA("RemoteEvent") then
            ev = existingEv
        else
            local newEv = Instance.new("RemoteEvent")
            newEv.Name = REMOTE_EVENT_NAME
            newEv.Parent = folder
            ev = newEv
        end
        carPartCollectedRemote = ev
    end

    -- 3. Resolve or create GetCarPartProgress RemoteFunction
    local rf = getCarPartProgressRemote
    if not (rf and rf.Parent == folder) then
        local existingRf = folder:FindFirstChild(REMOTE_FUNCTION_NAME)
        if existingRf and existingRf:IsA("RemoteFunction") then
            rf = existingRf
        else
            local newRf = Instance.new("RemoteFunction")
            newRf.Name = REMOTE_FUNCTION_NAME
            newRf.Parent = folder
            rf = newRf
        end
        getCarPartProgressRemote = rf
    end

    -- 4. Bind OnServerInvoke for GetCarPartProgress server-authoritatively
    rf.OnServerInvoke = function(player: Player)
        if not player or not player:IsA("Player") or not player:IsDescendantOf(Players) then
            return {}
        end
        return CarPartCollectionSystem.GetCollectedParts(player)
    end

    return folder, ev, rf
end

-- ----------------------------------------------------------------------------
-- HELPER FUNCTIONS
-- ----------------------------------------------------------------------------

--- Normalizes raw strings or aliases into a canonical ObjectiveId.
local function normalizeObjectiveId(rawId: string?): ObjectiveId?
    if not rawId or type(rawId) ~= "string" then
        return nil
    end

    local clean = string.gsub(rawId, "%s+", "")
    if clean == "Battery" or clean == "CronosBattery" or clean == "battery" then
        return "Battery"
    elseif clean == "Alternator" or clean == "alternator" then
        return "Alternator"
    elseif clean == "SparkPlugs" or clean == "sparkplugs" or clean == "Spark_Plugs" then
        return "SparkPlugs"
    elseif clean == "FuelCanister" or clean == "fuelcanister" or clean == "Fuel_Canister" then
        return "FuelCanister"
    elseif clean == "RadiatorHose" or clean == "radiatorhose" or clean == "Radiator_Hose" then
        return "RadiatorHose"
    end

    return nil
end

--- Retrieves the dedicated car repair parts container from Workspace.
local function getCarRepairPartsFolder(): Folder?
    local world = Workspace:FindFirstChild("EpecuenWorld")
    if not world then
        return nil
    end
    local folder = world:FindFirstChild("CarRepairParts")
    if folder and folder:IsA("Folder") then
        return folder
    end
    return nil
end

--- Resolves the canonical ObjectiveId from a Model instance.
--- Inspects model attributes first, then verifies model name.
local function resolveObjectiveFromModel(model: Model): (ObjectiveId?, string?)
    if not model or not model:IsA("Model") then
        return nil, nil
    end

    -- 1. Check attribute directly placed by CarPartPhysicalBuilder
    local attrId = model:GetAttribute("ObjectiveId")
    if type(attrId) == "string" then
        local normalized = normalizeObjectiveId(attrId)
        if normalized then
            return normalized, model.Name
        end
    end

    -- 2. Check model name against known mapping
    local fromName = MODEL_NAME_TO_OBJECTIVE[model.Name]
    if fromName then
        return fromName, model.Name
    end

    return nil, nil
end

--- Initializes the per-player tracking table.
local function setupPlayer(player: Player)
    if not playerProgress[player] then
        playerProgress[player] = {}
    end
    if not playerConnections[player] then
        playerConnections[player] = {}
    end
end

--- Safely cleans up a player's tracking table and connections on departure.
local function cleanupPlayer(player: Player)
    playerProgress[player] = nil
    local conns = playerConnections[player]
    if conns then
        for _, c in ipairs(conns) do
            if c and c.Connected then
                c:Disconnect()
            end
        end
        playerConnections[player] = nil
    end
end

--- Disconnects and cleans up a ProximityPrompt's internal tracking.
local function cleanupPrompt(prompt: ProximityPrompt)
    local conn = promptTriggerConnections[prompt]
    if conn then
        if conn.Connected then
            conn:Disconnect()
        end
        promptTriggerConnections[prompt] = nil
    end

    for id, p in pairs(promptByObjective) do
        if p == prompt then
            promptByObjective[id] = nil
        end
    end
end

-- ----------------------------------------------------------------------------
-- PROXIMITY PROMPT ATTACHMENT
-- ----------------------------------------------------------------------------

--- Configures exactly one ProximityPrompt on the specified physical vehicle component.
--- Safe against duplicate prompt creation.
function CarPartCollectionSystem.SetupPrompt(model: Model): ProximityPrompt?
    if not model or not model:IsA("Model") then
        return nil
    end

    local objectiveId, modelName = resolveObjectiveFromModel(model)
    if not objectiveId then
        return nil
    end

    -- Check if prompt already exists on the model or its descendants
    local existingPrompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if existingPrompt then
        promptByObjective[objectiveId] = existingPrompt
        return existingPrompt
    end

    -- Resolve Spanish component name
    local objectText = SPANISH_OBJECT_NAMES[objectiveId]
    local attrItemName = model:GetAttribute("ItemName")
    if type(attrItemName) == "string" and #attrItemName > 0 then
        objectText = attrItemName
    end

    -- Determine attachment parent: prefer model.PrimaryPart, fallback to model
    local targetAttachment: Instance = model.PrimaryPart or model

    -- Create ProximityPrompt
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = PROMPT_NAME
    prompt.ActionText = PROMPT_ACTION_TEXT
    prompt.ObjectText = objectText
    prompt.HoldDuration = PROMPT_HOLD_DURATION
    prompt.MaxActivationDistance = PROMPT_MAX_ACTIVATION_DISTANCE
    prompt.RequiresLineOfSight = PROMPT_REQUIRES_LINE_OF_SIGHT
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
    prompt.ClickablePrompt = true
    prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton

    -- Connect server-authoritative Triggered listener
    local triggerConn = prompt.Triggered:Connect(function(player: Player)
        CarPartCollectionSystem.CollectPart(player, model)
    end)

    promptTriggerConnections[prompt] = triggerConn
    promptByObjective[objectiveId] = prompt

    -- Handle prompt removal / model destruction
    prompt.Destroying:Connect(function()
        cleanupPrompt(prompt)
    end)

    prompt.Parent = targetAttachment
    return prompt
end

--- Scans Workspace.EpecuenWorld.CarRepairParts and configures prompts on all 5 components.
--- Returns the number of physical components configured with prompts.
function CarPartCollectionSystem.SetupAllPrompts(): number
    local folder = getCarRepairPartsFolder()
    if not folder then
        return 0
    end

    local count = 0
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("Model") then
            local prompt = CarPartCollectionSystem.SetupPrompt(child)
            if prompt then
                count += 1
            end
        end
    end

    return count
end

-- ----------------------------------------------------------------------------
-- SERVER-AUTHORITATIVE COLLECTION LOGIC
-- ----------------------------------------------------------------------------

--- Executes server-authoritative collection of a physical vehicle repair part.
---
--- Validates:
---   1. Player is active and legitimate.
---   2. Model is an authentic, uncollected vehicle repair part.
---   3. Resolves ObjectiveId server-side without trusting client claims.
---   4. Prevents duplicate collection.
---
--- Applies:
---   1. Marks objective as Found and Collected in CarPartObjectiveSystem.
---   2. Updates per-player collection progress.
---   3. Removes physical component model from the world.
function CarPartCollectionSystem.CollectPart(player: Player, model: Model): boolean
    -- 1. Validate player
    if not player or not player:IsA("Player") or not player:IsDescendantOf(Players) then
        return false
    end

    -- 2. Validate model
    if not model or not model:IsA("Model") or not model:IsDescendantOf(Workspace) then
        return false
    end

    -- 3. Atomic duplicate collection check
    if collectedModels[model] or isCollectingModel[model] then
        return false
    end

    -- 4. Server-authoritative objective resolution
    local objectiveId = resolveObjectiveFromModel(model)
    if not objectiveId then
        return false
    end

    -- Check if this specific player has already collected this objective
    if playerProgress[player] and playerProgress[player][objectiveId] == true then
        return false
    end

    -- Lock model to prevent concurrent activations during the frame
    isCollectingModel[model] = true

    -- Disable any attached prompt immediately
    local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        prompt.Enabled = false
    end

    -- 5. Mark objective as Found and Collected in CarPartObjectiveSystem
    CarPartObjectiveSystem.SetFound(objectiveId, true)
    CarPartObjectiveSystem.SetCollected(objectiveId, true)

    -- 6. Record per-player progress
    if not playerProgress[player] then
        playerProgress[player] = {}
    end
    playerProgress[player][objectiveId] = true

    -- Mark model as permanently collected
    collectedModels[model] = true
    isCollectingModel[model] = nil

    local modelName = model.Name

    -- 7. Remove the physical component from the world
    model:Destroy()

    -- 8. Fire decoupled server event
    partCollectedEvent:Fire(player, objectiveId, modelName)

    -- 9. Broadcast server-authoritative collection update to the collecting client
    if not carPartCollectedRemote then
        setupNetworking()
    end
    if carPartCollectedRemote then
        carPartCollectedRemote:FireClient(player, objectiveId, true)
    end

    return true
end

-- ----------------------------------------------------------------------------
-- PUBLIC API: PLAYER PROGRESSION (PER-PLAYER, SESSION PERSISTENT)
-- ----------------------------------------------------------------------------

--- Returns a table mapping collected ObjectiveId keys to true for the given player.
function CarPartCollectionSystem.GetCollectedParts(player: Player): PlayerProgressMap
    if not player or not player:IsA("Player") then
        return {}
    end

    local progress = playerProgress[player]
    if not progress then
        return {}
    end

    local copy: PlayerProgressMap = {}
    for k, v in pairs(progress) do
        copy[k] = v
    end
    return copy
end

--- Checks whether the given player has collected the specified vehicle repair part.
function CarPartCollectionSystem.HasCollected(player: Player, objectiveId: string): boolean
    if not player or not player:IsA("Player") then
        return false
    end

    local id = normalizeObjectiveId(objectiveId)
    if not id then
        return false
    end

    local progress = playerProgress[player]
    if not progress then
        return false
    end

    return progress[id] == true
end

--- Returns the total number of distinct vehicle repair parts collected by the player (0 to 5).
function CarPartCollectionSystem.GetCollectedCount(player: Player): number
    if not player or not player:IsA("Player") then
        return 0
    end

    local progress = playerProgress[player]
    if not progress then
        return 0
    end

    local count = 0
    for _, id in ipairs(CANONICAL_OBJECTIVE_ORDER) do
        if progress[id] == true then
            count += 1
        end
    end

    return count
end

--- Checks whether the player has collected all five vehicle repair parts.
function CarPartCollectionSystem.IsComplete(player: Player): boolean
    return CarPartCollectionSystem.GetCollectedCount(player) >= #CANONICAL_OBJECTIVE_ORDER
end

--- Returns the ProximityPrompt currently associated with the objective, if still active.
function CarPartCollectionSystem.GetPrompt(objectiveId: string): ProximityPrompt?
    local id = normalizeObjectiveId(objectiveId)
    if not id then
        return nil
    end
    return promptByObjective[id]
end

--- Returns the canonical ObjectiveId for a given model, or nil if not a valid car part model.
function CarPartCollectionSystem.GetObjectiveForModel(model: Model): ObjectiveId?
    local id, _ = resolveObjectiveFromModel(model)
    return id
end

--- Returns the list of 5 collectible model names.
function CarPartCollectionSystem.GetCollectibleModelNames(): { string }
    local list = {}
    for _, id in ipairs(CANONICAL_OBJECTIVE_ORDER) do
        table.insert(list, OBJECTIVE_TO_MODEL_NAME[id])
    end
    return list
end

--- Resets collected progress for a specific player.
function CarPartCollectionSystem.ResetPlayerProgress(player: Player): ()
    if player and playerProgress[player] then
        playerProgress[player] = {}
    end
end

--- Resets all player progress and collection locks in the current server session.
function CarPartCollectionSystem.ResetAll(): ()
    table.clear(playerProgress)
    table.clear(collectedModels)
    table.clear(isCollectingModel)
    for _, player in ipairs(Players:GetPlayers()) do
        setupPlayer(player)
    end
end

--- Returns the ReplicatedStorage CarPartRemotes folder.
function CarPartCollectionSystem.GetRemotesFolder(): Folder?
    if not carPartRemotesFolder then
        setupNetworking()
    end
    return carPartRemotesFolder
end

--- Returns the CarPartCollected RemoteEvent.
function CarPartCollectionSystem.GetCollectedRemoteEvent(): RemoteEvent?
    if not carPartCollectedRemote then
        setupNetworking()
    end
    return carPartCollectedRemote
end

--- Returns the GetCarPartProgress RemoteFunction.
function CarPartCollectionSystem.GetProgressRemoteFunction(): RemoteFunction?
    if not getCarPartProgressRemote then
        setupNetworking()
    end
    return getCarPartProgressRemote
end

-- ----------------------------------------------------------------------------
-- INITIALIZATION & LIFECYCLE MANAGEMENT
-- ----------------------------------------------------------------------------

--- Returns whether the collection system has been initialized.
function CarPartCollectionSystem.IsInitialized(): boolean
    return isInitialized
end

--- Explicit initialization function. Safe against duplicate execution.
--- Hooks player lifecycle events and attaches ProximityPrompts to models in CarRepairParts.
function CarPartCollectionSystem.Initialize(): boolean
    if isInitialized then
        return true
    end
    isInitialized = true

    -- 0. Ensure ReplicatedStorage.CarPartRemotes hierarchy is initialized server-side
    setupNetworking()

    -- 1. Initialize existing players
    for _, player in ipairs(Players:GetPlayers()) do
        setupPlayer(player)
    end

    -- 2. Hook player joining and leaving without memory leaks
    local playerAddedConn = Players.PlayerAdded:Connect(setupPlayer)
    local playerRemovingConn = Players.PlayerRemoving:Connect(cleanupPlayer)
    table.insert(systemConnections, playerAddedConn)
    table.insert(systemConnections, playerRemovingConn)

    -- 3. Hook CarRepairParts folder if present, or listen for its creation
    local function hookRepairPartsFolder(folder: Folder)
        CarPartCollectionSystem.SetupAllPrompts()

        local childAddedConn = folder.ChildAdded:Connect(function(child: Instance)
            if child:IsA("Model") then
                CarPartCollectionSystem.SetupPrompt(child)
            end
        end)
        table.insert(systemConnections, childAddedConn)
    end

    local existingFolder = getCarRepairPartsFolder()
    if existingFolder then
        hookRepairPartsFolder(existingFolder)
    else
        -- If folder hasn't been created yet, listen on EpecuenWorld or Workspace
        local world = Workspace:FindFirstChild("EpecuenWorld")
        if world then
            local worldConn = world.ChildAdded:Connect(function(child: Instance)
                if child.Name == "CarRepairParts" and child:IsA("Folder") then
                    hookRepairPartsFolder(child)
                end
            end)
            table.insert(systemConnections, worldConn)
        else
            local wsConn = Workspace.ChildAdded:Connect(function(child: Instance)
                if child.Name == "EpecuenWorld" then
                    local subConn = child.ChildAdded:Connect(function(subChild: Instance)
                        if subChild.Name == "CarRepairParts" and subChild:IsA("Folder") then
                            hookRepairPartsFolder(subChild)
                        end
                    end)
                    table.insert(systemConnections, subConn)
                end
            end)
            table.insert(systemConnections, wsConn)
        end
    end

    return true
end

--- Cleans up all connections and internal state.
function CarPartCollectionSystem.Cleanup(): ()
    isInitialized = false

    if getCarPartProgressRemote then
        getCarPartProgressRemote.OnServerInvoke = nil
    end

    for _, conn in ipairs(systemConnections) do
        if conn and conn.Connected then
            conn:Disconnect()
        end
    end
    table.clear(systemConnections)

    for prompt, conn in pairs(promptTriggerConnections) do
        if conn and conn.Connected then
            conn:Disconnect()
        end
    end
    table.clear(promptTriggerConnections)
    table.clear(promptByObjective)

    for player, conns in pairs(playerConnections) do
        for _, c in ipairs(conns) do
            if c and c.Connected then
                c:Disconnect()
            end
        end
    end
    table.clear(playerConnections)
    table.clear(playerProgress)
    table.clear(collectedModels)
    table.clear(isCollectingModel)
end

-- Pre-initialize networking deferred so remotes exist as early as possible
task.defer(setupNetworking)

return CarPartCollectionSystem
